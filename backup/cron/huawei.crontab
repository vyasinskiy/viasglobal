# ==============================================================================
# Crontab конфигурация сервера Huawei (100.92.50.18) для проекта Viasglobal
#
# Расписание:
# 1. 03:00 ежедневно - Полный бэкап всех 3 баз данных (viasglobal_db, rent, ecommerce)
#                      и выгрузка в облачное хранилище S3/Cloudflare R2.
# 2. 03:30 ежедневно - Проверка здоровья бэкапов и отправка heartbeat в Healthchecks.io.
# 3. 12:00 ежедневно - Дневная контрольная проверка свежести бэкапов (алерт в Telegram при сбое).
# ==============================================================================

# 1. Ежедневный бэкап всех баз данных (03:00)
0 3 * * * cd /home/huawei/viasglobal && bash backup/scripts/backup-all.sh >> /home/huawei/viasglobal/backend/backups/backup.log 2>&1

# 2. Утренняя валидация бэкапов и пинг мониторинга (03:30)
30 3 * * * cd /home/huawei/viasglobal && bash backup/scripts/check-health.sh >> /home/huawei/viasglobal/backend/backups/health.log 2>&1

# 3. Дневной контрольный мониторинг свежести бэкапов (12:00)
0 12 * * * cd /home/huawei/viasglobal && bash backup/scripts/check-health.sh >> /home/huawei/viasglobal/backend/backups/health.log 2>&1
