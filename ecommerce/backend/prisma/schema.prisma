generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// АВТОРИЗАЦИЯ
// ==========================================

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(MANAGER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ==========================================
// ПЛАТФОРМЫ ПРОДАЖ (Amazon, Etsy, ...)
// ==========================================

model Platform {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())

  salesOrders     SalesOrder[]
  externalIds     ProductExternalId[]
}

// ==========================================
// ПОСТАВЩИКИ (CRM / Воронка)
// ==========================================

enum SupplierStatus {
  NEW
  RESEARCHING
  FORM_SUBMITTED
  EMAIL_SENT
  CALLED
  NEGOTIATING
  ACCOUNT_OPENED
  REJECTED
  INACTIVE
}

enum CommunicationType {
  CALL
  EMAIL
  MEETING
  FORM
  OTHER
}

model Supplier {
  id              Int            @id @default(autoincrement())
  name            String         @unique
  website         String?
  country         String?
  email           String?
  phone           String?
  status          SupplierStatus @default(NEW)
  rejectionReason String?
  notes           String?
  lastContactAt   DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  contacts        SupplierContact[]
  communications  SupplierCommunication[]
  supplierProducts SupplierProduct[]
  purchases       Purchase[]
  documents       Document[]
}

model SupplierContact {
  id         Int      @id @default(autoincrement())
  supplierId Int
  name       String
  role       String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model SupplierCommunication {
  id              Int               @id @default(autoincrement())
  supplierId      Int
  type            CommunicationType
  date            DateTime          @default(now())
  summary         String
  nextAction      String?
  nextActionDate  DateTime?
  createdAt       DateTime          @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, date])
}

// ==========================================
// ТОВАРЫ (Мульти-платформенный каталог)
// ==========================================

model Product {
  id           Int      @id @default(autoincrement())
  sku          String   @unique
  name         String
  description  String?
  brand        String?
  manufacturer String?
  category     String?
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  externalIds          ProductExternalId[]
  supplierProducts     SupplierProduct[]
  purchaseItems        PurchaseItem[]
  salesItems           SalesOrderItem[]
  inventoryItems       InventoryItem[]
  inventoryMovements   InventoryMovement[]
  documents            Document[]
}

model ProductExternalId {
  id         Int      @id @default(autoincrement())
  productId  Int
  platformId Int
  externalId String
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  platform Platform @relation(fields: [platformId], references: [id])

  @@unique([platformId, externalId])
  @@index([productId])
  @@index([externalId])
}

// ==========================================
// ЦЕНЫ ПОСТАВЩИКОВ (Прайс-листы)
// ==========================================

model SupplierProduct {
  id           Int      @id @default(autoincrement())
  supplierId   Int
  productId    Int
  supplierSku  String?
  costPrice    Float
  currency     String   @default("EUR")
  taxRate      Float    @default(21.0)
  unitsPerBox  Int?
  minOrderQty  Int?
  validFrom    DateTime @default(now())
  validTo      DateTime?
  createdAt    DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([productId])
}

// ==========================================
// ЗАКУПКИ (Purchase Orders)
// ==========================================

enum PurchaseStatus {
  DRAFT
  SENT
  CONFIRMED
  PAID
  SHIPPED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Purchase {
  id                   Int            @id @default(autoincrement())
  supplierId           Int
  orderNumber          String?
  status               PurchaseStatus @default(DRAFT)
  orderDate            DateTime       @default(now())
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  shippingCost         Float          @default(0)
  taxAmount            Float          @default(0)
  totalAmount          Float          @default(0)
  currency             String         @default("EUR")
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  supplier Supplier       @relation(fields: [supplierId], references: [id])
  items    PurchaseItem[]
  documents Document[]

  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
}

model PurchaseItem {
  id                Int    @id @default(autoincrement())
  purchaseId        Int
  productId         Int
  quantity          Int
  unitPrice         Float
  totalPrice        Float
  receivedQuantity  Int    @default(0)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

// ==========================================
// ПРОДАЖИ (Sales Orders с платформ)
// ==========================================

enum SalesOrderStatus {
  PENDING
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

model SalesOrder {
  id              Int              @id @default(autoincrement())
  platformId      Int
  platformOrderId String
  orderDate       DateTime         @default(now())
  shipDate        DateTime?
  deliveryDate    DateTime?
  status          SalesOrderStatus @default(PENDING)
  totalAmount     Float            @default(0)
  platformFees    Float            @default(0)
  shippingCost    Float            @default(0)
  netAmount       Float            @default(0)
  currency        String           @default("EUR")
  customerInfo    Json?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  platform Platform         @relation(fields: [platformId], references: [id])
  items    SalesOrderItem[]
  documents Document[]

  @@unique([platformId, platformOrderId])
  @@index([platformId])
  @@index([orderDate])
  @@index([status])
}

model SalesOrderItem {
  id           Int    @id @default(autoincrement())
  salesOrderId Int
  productId    Int
  quantity     Int
  unitPrice    Float
  totalPrice   Float
  platformFee  Float  @default(0)
  costPrice    Float?

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@index([salesOrderId])
  @@index([productId])
}

// ==========================================
// СКЛАДСКОЙ УЧЕТ (Inventory)
// ==========================================

enum WarehouseType {
  OWN
  FBA
  THIRD_PARTY
}

enum MovementType {
  IN
  OUT
  RESERVE
  UNRESERVE
  ADJUST
  RETURN
}

model InventoryItem {
  id               Int           @id @default(autoincrement())
  productId        Int
  warehouse        WarehouseType
  quantity         Int           @default(0)
  reservedQuantity Int           @default(0)
  minStockLevel    Int?
  updatedAt        DateTime      @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouse])
  @@index([productId])
  @@index([warehouse])
}

model InventoryMovement {
  id            Int          @id @default(autoincrement())
  productId     Int
  warehouse     WarehouseType
  type          MovementType
  quantity      Int
  referenceType String?
  referenceId   Int?
  date          DateTime     @default(now())
  notes         String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, date])
  @@index([referenceType, referenceId])
}

// ==========================================
// ДОКУМЕНТЫ
// ==========================================

enum EntityType {
  SUPPLIER
  PURCHASE
  SALE
  PRODUCT
}

enum DocumentType {
  INVOICE
  CONTRACT
  PRICE_LIST
  SHIPPING_LABEL
  DELIVERY_NOTE
  OTHER
}

model Document {
  id           Int          @id @default(autoincrement())
  entityType   EntityType
  entityId     Int
  documentType DocumentType
  fileName     String
  filePath     String
  fileSize     Int?
  mimeType     String?
  uploadedAt   DateTime     @default(now())
  notes        String?

  supplierId Int?
  purchaseId Int?
  saleId     Int?
  productId  Int?

  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  sale     SalesOrder? @relation(fields: [saleId], references: [id], onDelete: SetNull)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([supplierId])
  @@index([purchaseId])
  @@index([saleId])
  @@index([productId])
}

// ==========================================
// АНАЛИТИЧЕСКИЕ ПРЕДСТАВЛЕНИЯ
// ==========================================

view PurchaseMarginView {
  purchaseId    Int    @unique
  orderNumber   String?
  supplierName  String
  orderDate     DateTime
  status        String
  totalCost     Float
  shippingCost  Float
  taxAmount     Float
  totalAmount   Float
  totalRevenue  Float?
  grossProfit   Float?
  marginPercent Float?
}

view ProductProfitabilityView {
  productId       Int    @unique
  sku             String
  name            String
  brand           String?
  category        String?
  avgCostPrice    Float?
  avgSellPrice    Float?
  totalSold       Int?
  totalRevenue    Float?
  totalCost       Float?
  grossProfit     Float?
  marginPercent   Float?
}

view InventoryStatusView {
  productId     Int
  sku           String
  name          String
  warehouse     String
  quantity      Int
  reserved      Int
  available     Int
  minStockLevel Int?
  isLowStock    Boolean?
}