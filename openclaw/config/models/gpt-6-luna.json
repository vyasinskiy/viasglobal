{
  "preset": "gpt-6-luna",
  "name": "OpenAI: GPT-6 Luna",
  "modelId": "openrouter/openai/gpt-6-luna",
  "provider": "openrouter",
  "model": {
    "id": "openai/gpt-6-luna",
    "name": "OpenAI: GPT-6 Luna",
    "contextTokens": 200000,
    "contextWindow": 1050000
  },
  "compaction": {
    "enabled": true,
    "mode": "safeguard",
    "maxActiveTranscriptBytes": "5mb",
    "recentTurnsPreserve": 5,
    "midTurnPrecheck": {
      "enabled": true
    }
  },
  "contextPruning": {
    "mode": "cache-ttl",
    "ttl": "30m"
  }
}
