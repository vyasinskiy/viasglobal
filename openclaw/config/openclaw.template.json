{
  "env": {
    "vars": {
      "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}"
    }
  },
  "models": {
    "providers": {
      "openrouter": {
        "models": [
          {
            "id": "openai/gpt-6-luna",
            "name": "OpenAI: GPT-6 Luna",
            "contextTokens": 64000,
            "contextWindow": 1050000
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/openai/gpt-6-luna"
      },
      "models": {
        "openrouter/openai/gpt-6-luna": {}
      },
      "modelPolicy": {
        "allow": [
          "openrouter/openai/gpt-6-luna"
        ]
      },
      "compaction": {
        "enabled": true,
        "mode": "safeguard",
        "maxActiveTranscriptBytes": "2mb",
        "recentTurnsPreserve": 3,
        "midTurnPrecheck": {
          "enabled": true
        }
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "5m"
      },
      "heartbeat": {
        "every": "0m"
      }
    },
    "entries": {
      "main": {}
    }
  },
  "messages": {
    "responseUsage": "full",
    "usageTemplate": {
      "schema": "openclaw.usageBar.v1",
      "scales": {
        "braille": "⠐⡀⡄⡆⡇⣇⣧⣷⣿"
      },
      "output": {
        "sep": " | ",
        "default": [
          {
            "text": "🤖 {model.display_name}"
          },
          {
            "when": "context.max_tokens",
            "text": "📊 Контекст: [{context.pct_used|meter:5:braille}] {context.used_tokens|num}/{context.max_tokens|num} ({context.pct_used}%)"
          },
          {
            "when": "cost.turn_usd",
            "text": "💰 Запрос: ${cost.turn_usd|fixed:4}"
          },
          {
            "when": "usage.total_tokens",
            "text": "⚡ {usage.total_tokens|num} tok"
          }
        ]
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "allowlist",
      "allowFrom": [
        "${TELEGRAM_ALLOWED_USERS}"
      ],
      "groupAllowFrom": [
        "${TELEGRAM_ALLOWED_USERS}"
      ]
    }
  },
  "commands": {
    "ownerAllowFrom": [
      "telegram:${TELEGRAM_ALLOWED_USERS}"
    ]
  },
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "auto",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "allowedOrigins": [
        "http://localhost:18789",
        "http://127.0.0.1:18789"
      ]
    }
  },
  "memory": {
    "search": {
      "enabled": false
    }
  },
  "meta": {
    "migrations": {
      "modelPolicyAllowlist": true,
      "utilityModelSeparation": true
    },
    "lastTouchedVersion": "2026.9.8"
  },
  "plugins": {
    "entries": {
      "openrouter": {
        "enabled": true
      }
    }
  }
}
