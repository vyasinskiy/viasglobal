generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Language {
  id    Int    @id @default(autoincrement())
  code  String @unique
  name  String

  words    Word[]
  tags     Tag[]
  sessions StudySession[]

  @@map("languages")
}

model Word {
  id          Int      @id @default(autoincrement())
  languageId  Int
  english     String
  russian     String
  exampleEn   String
  exampleRu   String
  baseWordId  Int?     @map("base_word_id")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isFavorite  Boolean  @default(false)

  language    Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  baseWord    Word?    @relation("WordToForms", fields: [baseWordId], references: [id], onDelete: Cascade)
  forms       Word[]   @relation("WordToForms")
  answers     Answer[]
  tags        WordTag[]
  activities  SessionActivity[]

  @@index([languageId])
  @@index([baseWordId])
  @@map("words")
}

model Tag {
  id         Int      @id @default(autoincrement())
  languageId Int
  name       String
  createdAt  DateTime @default(now())

  language   Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)
  words      WordTag[]

  @@unique([languageId, name])
  @@index([languageId])
  @@map("tags")
}

model WordTag {
  wordId Int
  tagId  Int

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([wordId, tagId])
  @@index([tagId])
  @@map("word_tags")
}

model Answer {
  id        Int      @id @default(autoincrement())
  wordId    Int
  answer    String
  isCorrect Boolean
  isSynonym Boolean  @default(false)
  createdAt DateTime @default(now())
  
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  
  @@map("answers")
}

model StudySession {
  id          Int               @id @default(autoincrement())
  languageId  Int
  sessionDate DateTime          @db.Date
  nextClicks  Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  
  language    Language          @relation(fields: [languageId], references: [id], onDelete: Cascade)
  activities  SessionActivity[]

  @@unique([languageId, sessionDate], map: "uq_study_sessions_lang_date")
  @@index([sessionDate])
  @@index([languageId])
  @@map("study_sessions")
}

model SessionActivity {
  id           Int          @id @default(autoincrement())
  sessionId    Int
  wordId       Int
  activityType String       @db.VarChar(32)
  userAnswer   String?
  createdAt    DateTime     @default(now())

  session      StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  word         Word         @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([wordId])
  @@index([activityType])
  @@map("session_activities")
}

