# Настройки HTTP сервера для REST API (OpenClaw и внутренние сервисы)
PORT=3040

# Настройки Telegram бота для форвардинга входящих SMS и алертов
# Токен бота (например, бот оповещений аренды или персональный агент)
TELEGRAM_BOT_TOKEN=8489630295:AAF3DXOtIxmm0Gd-zdguw_h_FbTI2bRcKYo

# Chat ID получателя (ID владельца 743866013 или ID группы/канала)
# Можно указать несколько через запятую: 743866013,-1002956618012
TELEGRAM_CHAT_ID=743866013,-1002956618012

# Путь к исполняемому файлу adb (на хосте Huawei: /home/huawei/.local/bin/adb или системный adb)
ADB_PATH=adb

# Серийный номер USB-устройства (если пусто - определяется автоматически первое доступное)
# Для Meizu U20: U20AVCPM22MQH
ADB_DEVICE_SERIAL=

# Интервал опроса входящих SMS через ADB (в миллисекундах)
POLL_INTERVAL_MS=5000

# Интервал проверки состояния устройства (батарея, связь, USB) (в миллисекундах)
HEALTH_CHECK_INTERVAL_MS=60000

# Порог низкого заряда батареи для отправки тревожного уведомления в Telegram (в процентах)
LOW_BATTERY_THRESHOLD=15

# Путь к файлу базы данных SQLite
DATABASE_PATH=./data/sms.db

# Флаг включения отправки уведомлений в Telegram (true / false)
ENABLE_TELEGRAM_NOTIFICATIONS=true

# Часовой пояс для форматирования времени в сообщениях
TZ=Europe/Madrid
