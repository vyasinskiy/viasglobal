# LLM Провайдер OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
MODEL=deepseek/deepseek-chat

# Настройки шлюза Telegram
TELEGRAM_BOT_TOKEN=your_agent_telegram_bot_token_here
TELEGRAM_ALLOWED_USERS=743866013

# Внутренние URL микросервисов для вызовов по HTTP
ACCOUNTANT_API_URL=http://accruals-accountant:3005
BACKEND_API_URL=http://backend:3000

# Опционально: ключи для транскрибации голосовых сообщений (Whisper)
GROQ_API_KEY=
OPENAI_API_KEY=

