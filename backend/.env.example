DATABASE_URL="postgresql://user:password@localhost:5432/viasglobal_db?schema=public"
KEEPA_API_KEY=your_keepa_api_key_here
# Скорость восстановления токенов Keepa API в минуту (например 5). Влияет на размер пачки обработки.
KEEPA_API_TOKENS_PER_MINUTE=1
# Если true, запрашивает список конкурентов (offers=20). Это добавляет +2 токена к стоимости каждого запроса.
# По умолчанию выключено (false), чтобы парсинг очереди был в 3 раза дешевле и не уводил баланс в минус при лимите 1 токен/мин.
KEEPA_FETCH_OFFERS=false

# Настройки для выгрузки бэкапов в Amazon S3
AWS_BACKUP_BUCKET="your_bucket_name"
AWS_BACKUP_REGION="eu-north-1"
AWS_ACCESS_KEY_ID="your_access_key_here"
AWS_SECRET_ACCESS_KEY="your_secret_key_here"
