view PrivateLabelView {
  id         Int      @unique
  brandId    Int
  sellerId   String
  brandName  String
  sellerName String
  createdAt  DateTime
  updatedAt  DateTime
}

view AsinView {
  id          Int     @unique
  asin        String
  ean         String?
  brand       String?
  seller      String?
  buyBoxPrice Float?
  maxBuyPrice Float?
}


