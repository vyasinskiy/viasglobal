view PrivateLabelView {
  id         Int      @unique
  brandId    Int
  sellerId   String
  brandName  String
  sellerName String
  notes      String?
  createdAt  DateTime
  updatedAt  DateTime
}

view AsinView {
  id          Int     @unique
  asin        String
  ean         String?
  brand       String?
  seller      String?
  buyBoxPrice Float?
  maxBuyPrice Float?
}

view KeepaExportView {
  id         Int      @unique
  brandName  String?
  sellerName String?
  createdAt  DateTime
  brandId    Int?
  sellerId   String?
}


/// Сводное представление товаров брендов в работе С ФИЛЬТРАМИ (BSR <= 100k, Amazon <= 50%, BuyBox >= 10€)
view ContractedFilteredProductsView {
  asinId        Int?    /// Внутренний ID товара в таблице ASIN
  asin          String? /// ASIN товара
  ean           String? /// EAN/штрихкод товара
  salesRank     Int?    /// Текущий рейтинг продаж BSR на Amazon
  boughtInPastMonth Int? /// Количество продаж за прошлый месяц (бейдж "X+ bought in past month" на Amazon)
  estimatedMonthlySales Int? /// Примерная оценка продаж в месяц по падениям BSR Keepa (salesRankDropsLast90Days / 3)
  netProfit     Float?  /// Чистая прибыль (с вычетом налога на комиссии для Recargo)
  minBoxOrderGross Float? /// Стоимость минимальной партии брутто (с налогами)
  minBoxOrder   Int?    /// Минимальный объем партии в штуках (unitsPerBox * minBoxEnvases для кратности коробок)
  unitsPerBox   Int?    /// Вместимость заводской коробки в штуках (EMBALAJE / UNI CAJA STD)
  netPrice      Float?  /// Цена закупки нетто (без налогов)
  grossPrice    Float?  /// Цена закупки брутто (с налогами)
  costPrice     Float?  /// Себестоимость закупки с налогами (синоним grossPrice для обратной совместимости)
  title         String? /// Название товара
  brand         String? /// Название бренда
  distributor   String? /// Название поставщика/дистрибьютора
  manufacturer  String? /// Название производителя
  buyBoxPrice   Float?  /// Текущая цена продажи Buy Box на Amazon
  fbaFee        Float?  /// Логистическая комиссия FBA (Pick & Pack)
  referralFee   Float?  /// Комиссия площадки Amazon (Referral Fee)
  amazonFees    Float?  /// Суммарные комиссии Amazon (FBA + Referral без НДС)
  vatOnFees     Float?  /// 21% НДС на комиссии Amazon (включается в расходы на режиме Recargo de Equivalencia)
  roiPercent    Float?  /// Рентабельность инвестиций ROI (%) = (netProfitPerUnit / grossPrice) * 100
  marginPercent Float?  /// Маржинальность продаж Margin (%) = (netProfitPerUnit / buyBoxPrice) * 100
  minBoxOrderNetto Float? /// Стоимость минимальной партии нетто (без налогов)
  feeStatus     String? /// Статус расчета комиссий и габаритов FBA (FeeCalculationStatus)
}

/// Сводное представление ВСЕХ товаров брендов в работе БЕЗ ФИЛЬТРОВ (без ограничений по BSR, цене и Amazon)
view ContractedAllProductsView {
  asin           String? /// ASIN товара
  ean            String? /// EAN/штрихкод товара
  salesRank      Int?    /// Текущий рейтинг продаж BSR на Amazon
  boughtInPastMonth Int? /// Количество продаж за прошлый месяц (бейдж "X+ bought in past month" на Amazon)
  estimatedMonthlySales Int? /// Примерная оценка продаж в месяц по падениям BSR Keepa (salesRankDropsLast90Days / 3)
  netProfitPerMinBoxOrder Float? /// Чистая прибыль с минимальной партии
  profitCoefficient Float? /// Коэффициент прибыли = netProfitPerMinBoxOrder / minBoxOrderGross
  minBoxOrderGross Float? /// Стоимость минимальной партии брутто (с налогами)
  grossPrice     Float?  /// Цена закупки брутто (с налогами)
  title          String? /// Название товара
  netProfitPerUnit Float? /// Чистая прибыль с одной штуки
  minBoxOrderNetto Float? /// Стоимость минимальной партии нетто (без налогов)
  minBoxOrder    Int?    /// Минимальный объем партии в штуках (unitsPerBox * minBoxEnvases для кратности коробок)
  unitsPerBox    Int?    /// Вместимость заводской коробки в штуках (EMBALAJE / UNI CAJA STD)
  netPrice       Float?  /// Цена закупки нетто (без налогов)
  costPrice      Float?  /// Себестоимость закупки с налогами (синоним grossPrice для обратной совместимости)
  brand          String? /// Название бренда
  distributor    String? /// Название поставщика/дистрибьютора
  manufacturer   String? /// Название производителя
  buyBoxPrice    Float?  /// Текущая цена продажи Buy Box на Amazon
  fbaFee         Float?  /// Логистическая комиссия FBA (Pick & Pack)
  referralFee    Float?  /// Комиссия площадки Amazon (Referral Fee)
  amazonFees     Float?  /// Суммарные комиссии Amazon (FBA + Referral без НДС)
  vatOnFees      Float?  /// 21% НДС на комиссии Amazon (включается в расходы на режиме Recargo de Equivalencia)
  roiPercent     Float?  /// Рентабельность инвестиций ROI (%) = (netProfitPerUnit / grossPrice) * 100
  marginPercent  Float?  /// Маржинальность продаж Margin (%) = (netProfitPerUnit / buyBoxPrice) * 100
  feeStatus      String? /// Статус расчета комиссий и габаритов FBA (FeeCalculationStatus)
}

model KeepaExport {
  id        Int      @id @default(autoincrement())
  sellerId  String?
  brandId   Int?
  seller    Seller?  @relation(fields: [sellerId], references: [id])
  brand     Brand?   @relation(fields: [brandId], references: [id])
  createdAt DateTime @default(now())

  asins     ASIN[]
}


// ==========================================
// KEEPA API DATA PROCESSING
// ==========================================

model RequestProductQueue {
  id          Int      @id @default(autoincrement())
  asin        String   @unique
  priority    Int      @default(0)
  addedAt     DateTime @default(now())
}

model KeepaApiRawResponse {
  asin        String   @id
  rawPayload  Json?
  fetchedAt   DateTime?
  expiresAt   DateTime?
  isProcessed Boolean  @default(false)
  error       String?
}

model KeepaApiProcessedData {
  asin               String   @id
  
  // Идентификация
  title              String?
  brand              String?
  manufacturer       String?
  
  // Дополнительная Идентификация (как в ProductFinder)
  model              String?
  color              String?
  size               String?
  style              String?
  pattern            String?
  material           String?
  itemType           String?

  // Бренд-Стор
  brandStoreName     String?
  brandStoreUrlName  String?

  // Характеристики
  isAdultProduct     Boolean?
  isHeatSensitive    Boolean?
  isEligibleForTradeIn Boolean?
  hasReviews         Boolean?

  // Габариты упаковки (мм, граммы)
  packageLength      Float?
  packageWidth       Float?
  packageHeight      Float?
  packageWeight      Float?
  sizeTier           String?
  
  // Габариты самого товара (мм, граммы)
  itemLength         Float?
  itemWidth          Float?
  itemHeight         Float?
  itemWeight         Float?
  
  // Финансы и комиссии
  fbaFee             Float?
  pickAndPackFee     Float?
  referralFeePercent Float?
  
  // Статистика (если запрашивалась)
  currentSalesRank   Int?
  avg90SalesRank     Int?
  monthlySold        Int? // Bought in last month estimate
  
  // Категории
  rootCategory       String?
  categoryTree       Json?
  
  // Списки и нескалярные данные
  eanList            String[]
  upcList            String[]
  gtinList           String[]
  images             Json?
  features           String[]
  offers             Json?
  buyBoxSellerIdHistory Json?
  buyBoxEligibleOfferCounts Json?
  
  // Вариации
  variationCSV       String?
  
  lastProcessedAt    DateTime @default(now())
}

model AnalysisProductQueue {
  asin        String   @id
  priority    Int      @default(0)
  addedAt     DateTime @default(now())
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  asins ASIN[]
}

// Список разрешенных безопасных категорий для парсинга через Keepa Product Finder API
model KeepaAllowedCategory {
  id         Int      @id @default(autoincrement())
  categoryId String   @unique // Keepa Browse Node ID категории (например, "599391031")
  name       String   // Название категории (например, "Hogar y cocina")
  domainId   Int      @default(4) // Идентификатор домена Keepa (4 = amazon.es)
  isActive   Boolean  @default(true) // Флаг активности категории для регулярного опроса
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==========================================
// ПЕРСИСТЕНТНАЯ ОЧЕРЕДЬ ЗАПРОСОВ В KEEPA API
// ==========================================

enum KeepaRequestType {
  PRODUCT_ASINS   // Запрос карточек товаров (/product?asin=...)
  CATEGORY_FINDER // Поиск по категории (/query)
  BRAND_FINDER    // Поиск по бренду (/query)
  SELLER_FINDER   // Поиск по продавцу (/query)
}

enum KeepaRequestStatus {
  PENDING    // Ожидает выполнения
  PROCESSING // Выполняется прямо сейчас
  COMPLETED  // Успешно выполнен и обработан
  FAILED     // Ошибка выполнения
}

model KeepaRequestQueue {
  id            Int                @id @default(autoincrement())
  type          KeepaRequestType
  priority      Int                @default(10) // 100 - critical, 50 - high, 10 - normal, 1 - low
  status        KeepaRequestStatus @default(PENDING)
  payload       Json               // Входные параметры запроса
  expectedCost  Int                @default(1)  // Ожидаемый расход токенов Keepa
  resultSummary Json?              // Сводка результата (найдено, обновлено)
  error         String?            // Текст ошибки при сбое
  attempts      Int                @default(0)
  createdAt     DateTime           @default(now())
  startedAt     DateTime?
  completedAt   DateTime?

  @@index([status, priority, createdAt])
}

// ==========================================
// E-COMMERCE: ЗАКУПКИ, СКЛАДСКОЙ УЧЕТ И ПРОДАЖИ
// ==========================================

enum PurchaseOrderStatus {
  DRAFT              // Черновик заказа
  CONFIRMED          // Заказ подтвержден поставщиком
  SHIPPED            // Отгружен поставщиком (в пути)
  PARTIALLY_RECEIVED // Частично принят на складе
  RECEIVED           // Полностью принят на складе
  CANCELLED          // Отменен
}

enum WarehouseLocation {
  SVH  // Склад временного хранения / оперативный буфер (откуда отправляются заказы)
  MAIN // Основной склад длительного хранения
  FBA  // Склад Amazon FBA
}

enum StockMovementType {
  RECEIPT    // Приемка товара от поставщика
  TRANSFER   // Перемещение между складами (MAIN -> SVH, SVH -> MAIN)
  SALE_OUT   // Списание при продаже на маркетплейсе (Amazon)
  ADJUSTMENT // Инвентаризация / ручная корректировка
  RETURN     // Возврат товара
}

enum SalesOrderStatus {
  PENDING   // Заказ оформлен / ожидает сборки
  SHIPPED   // Отправлен покупателю
  DELIVERED // Доставлен покупателю
  CANCELLED // Отменен
  RETURNED  // Возвращен покупателем
}

enum OrderDocumentType {
  ALBARAN           // Товарно-транспортная накладная поставщика (Albarán)
  INVOICE           // Счет-фактура (Factura)
  RECEIVING_PHOTO   // Фото товара/коробок при приемке
  MEASUREMENT_PHOTO // Фото замеров рулеткой / весов
  PAYMENT_RECEIPT   // Квитанция об оплате / банковская выписка SEPA
  SHIPPING_LABEL    // Транспортная этикетка / трек-номер
  OTHER             // Прочие документы
}

/// Заказ поставщику / Партия товаров (Purchase Order)
model PurchaseOrder {
  id                   Int                 @id @default(autoincrement())
  distributorId        Int                 /// Внешний ключ: связанный дистрибьютор / поставщик
  orderNumber          String              /// Номер заказа или накладной (например, "26ALV-0074072")
  status               PurchaseOrderStatus @default(DRAFT)
  orderDate            DateTime            @default(now()) /// Дата оформления заказа
  expectedDeliveryDate DateTime?           /// Ожидаемая дата доставки
  actualDeliveryDate   DateTime?           /// Фактическая дата поступления на склад
  shippingCost         Float               @default(0) /// Стоимость доставки (€)
  subtotalNetto        Float               @default(0) /// Сумма чистой базы без налогов и эко-тасы (€)
  totalEcoTasa         Float               @default(0) /// Суммарный сбор эко-тасы RAEE (€)
  taxAmount            Float               @default(0) /// Сумма налогов (IVA 21% + RE 5.2%) (€)
  totalGross           Float               @default(0) /// Итоговая себестоимость партии брутто (€)
  currency             String              @default("EUR")
  paymentMethod        String?             /// Метод оплаты (например, "SEPA Direct Debit B2B")
  paymentStatus        String              @default("PENDING") /// Статус оплаты (PENDING, PAID)
  notes                String?             /// Дополнительные примечания

  distributor          Distributor         @relation(fields: [distributorId], references: [id])
  items                PurchaseOrderItem[]
  documents            OrderDocument[]
  stockMovements       StockMovement[]

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([distributorId, orderNumber])
  @@index([distributorId])
  @@index([orderDate])
  @@index([status])
}

/// Позиция в заказе поставщика (товар в партии)
model PurchaseOrderItem {
  id                Int       @id @default(autoincrement())
  purchaseOrderId   Int       /// Внешний ключ: связанный заказ на закупку
  asinId            Int?      /// Внешний ключ: привязка к каталогу ASIN (если товар есть на Amazon)
  sku               String    /// Артикул товара у поставщика (Referencia, например "34316")
  ean               String?   /// Штрихкод EAN (например "8425160343163")
  title             String    /// Наименование товара
  quantityOrdered   Int       /// Заказанное количество (штук)
  quantityReceived  Int       @default(0) /// Фактически принятое количество (штук)
  priceNetto        Float     /// Оптовая чистая цена за единицу (€, без НДС и тасы)
  ecoTasa           Float     @default(0) /// Эко-таса за единицу (€)
  costPrice         Float     /// Себестоимость за единицу с налогами (€: (priceNetto + ecoTasa) * 1.262)
  totalCostGross    Float     /// Суммарная себестоимость позиции брутто (€: costPrice * quantityOrdered)
  
  // Фактические замеры заводской упаковки при приемке груза
  packageLengthCm   Float?    /// Длина заводской коробки (см)
  packageWidthCm    Float?    /// Ширина заводской коробки (см)
  packageHeightCm   Float?    /// Высота заводской коробки (см)
  packageWeightG    Float?    /// Фактический вес единицы/коробки брутто (граммы)
  notes             String?   /// Заметки по качеству, расхождениям и упаковке

  purchaseOrder     PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  asin              ASIN?                 @relation(fields: [asinId], references: [id])
  allocations       BatchSalesAllocation[] /// Сквозная привязка к заказам покупателей
  documents         OrderDocument[]
  stockMovements    StockMovement[]

  @@index([purchaseOrderId])
  @@index([asinId])
  @@index([sku])
}

/// Складские остатки по складам (SVH, MAIN, FBA)
model WarehouseStock {
  id               Int               @id @default(autoincrement())
  warehouse        WarehouseLocation /// Локация склада (SVH - буфер оперативной отправки, MAIN - основной склад)
  sku              String            /// Артикул товара
  asinId           Int?              /// Привязка к ASIN
  title            String?           /// Наименование для быстрого просмотра
  quantity         Int               @default(0) /// Физический остаток в наличии на складе
  reservedQuantity Int               @default(0) /// Зарезервировано под оформленные продажи
  minStockAlert    Int               @default(1) /// Страховой порог: при остатке <= порога отправляется алерт пополнения
  updatedAt        DateTime          @updatedAt

  asin             ASIN?             @relation(fields: [asinId], references: [id])

  @@unique([warehouse, sku])
  @@index([warehouse])
  @@index([sku])
}

/// Журнал складских перемещений и списаний
model StockMovement {
  id                  Int                @id @default(autoincrement())
  sku                 String             /// Артикул перемещаемого товара
  asinId              Int?               /// Привязка к ASIN
  fromWarehouse       WarehouseLocation? /// Склад списания (null при первичной приемке)
  toWarehouse         WarehouseLocation? /// Склад зачисления (null при продаже покупателю)
  type                StockMovementType  /// Тип операции (RECEIPT, TRANSFER, SALE_OUT, ADJUSTMENT, RETURN)
  quantity            Int                /// Количество единиц
  purchaseOrderId     Int?               /// Ссылка на партию закупки (при оприходовании)
  purchaseOrderItemId Int?               /// Ссылка на конкретную строку партии
  salesOrderId        Int?               /// Ссылка на заказ покупателя (при списании)
  notes               String?            /// Обоснование / примечание
  createdAt           DateTime           @default(now())

  asin                ASIN?              @relation(fields: [asinId], references: [id])
  purchaseOrder       PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  salesOrder          SalesOrder?        @relation(fields: [salesOrderId], references: [id])

  @@index([sku, createdAt(sort: Desc)])
  @@index([type])
  @@index([purchaseOrderId])
  @@index([salesOrderId])
}

/// Заказ покупателя на маркетплейсе (продажа)
model SalesOrder {
  id                 Int               @id @default(autoincrement())
  platform           String            @default("AMAZON") /// Маркетплейс (AMAZON, ETSY)
  orderNumber        String            @unique /// Номер заказа маркетплейса (например Amazon Order ID: 402-1234567-8901234)
  orderDate          DateTime          @default(now()) /// Дата совершения покупки
  status             SalesOrderStatus  @default(PENDING)
  fulfillmentChannel String            @default("FBM") /// Метод исполнения (FBM - доставка со склада СВХ, FBA)
  warehouse          WarehouseLocation @default(SVH) /// Склад, с которого производится отгрузка
  totalAmount        Float             /// Сумма продажи, уплаченная клиентом (€)
  platformFees       Float             @default(0) /// Комиссия маркетплейса Amazon Referral Fee (€)
  shippingFee        Float             @default(0) /// Стоимость доставки покупателю курьерской службой (€)
  netAmount          Float             @default(0) /// Чистая выручка продавца (€: totalAmount - platformFees - shippingFee)
  currency           String            @default("EUR")
  customerCity       String?           /// Город доставки покупателя
  customerCountry    String?           @default("ES") /// Страна доставки
  trackingNumber     String?           /// Номер отслеживания посылки
  notes              String?           /// Дополнительные заметки

  items              SalesOrderItem[]
  stockMovements     StockMovement[]
  documents          OrderDocument[]

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([orderDate])
  @@index([status])
}

/// Строка заказа покупателя
model SalesOrderItem {
  id           Int                    @id @default(autoincrement())
  salesOrderId Int                    /// Связанный заказ продажи
  sku          String                 /// Артикул проданного товара
  asinId       Int?                   /// Связанный ASIN
  quantity     Int                    /// Количество проданных штук
  salePrice    Float                  /// Цена продажи за единицу (€)
  platformFee  Float                  @default(0) /// Комиссия маркетплейса за единицу (€)
  shippingCost Float                  @default(0) /// Затраты на упаковку и доставку за единицу (€)
  costPrice    Float?                 /// Фактическая себестоимость списанной единицы из партии (€)
  netProfit    Float?                 /// Чистая прибыль с единицы (€: salePrice - platformFee - shippingCost - costPrice)

  salesOrder   SalesOrder             @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  asin         ASIN?                  @relation(fields: [asinId], references: [id])
  allocations  BatchSalesAllocation[] /// Связка со списанной партией

  @@index([salesOrderId])
  @@index([sku])
}

/// Сквозная привязка списания партии: какая единица из какой поставки была продана
model BatchSalesAllocation {
  id                    Int               @id @default(autoincrement())
  purchaseOrderItemId   Int               /// Из какой строки партии закупки списан товар
  salesOrderItemId      Int               /// В какой заказ покупателя направлен товар
  quantity              Int               /// Количество списанных единиц из данной партии
  costPriceAtAllocation Float             /// Точная себестоимость единицы из данной партии на момент списания (€)
  createdAt             DateTime          @default(now())

  purchaseOrderItem     PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  salesOrderItem        SalesOrderItem    @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderItemId])
  @@index([salesOrderItemId])
}

/// Документы и медиафайлы заказов, поставок и приемки
model OrderDocument {
  id                  Int                @id @default(autoincrement())
  distributorId       Int?               /// Связанный дистрибьютор / поставщик
  purchaseOrderId     Int?               /// Связанный заказ закупки / партия
  purchaseOrderItemId Int?               /// Связанная товарная позиция (для фото конкретного товара)
  salesOrderId        Int?               /// Связанный заказ продажи (чек, накладная)
  documentType        OrderDocumentType  /// Тип документа (ALBARAN, INVOICE, RECEIVING_PHOTO, MEASUREMENT_PHOTO и т.д.)
  fileName            String             /// Имя файла
  filePath            String             /// Путь к файлу на диске или в хранилище
  fileSize            Int?               /// Размер файла в байтах
  mimeType            String?            /// MIME-тип (application/pdf, image/jpeg)
  notes               String?            /// Описание или примечание
  createdAt           DateTime           @default(now())

  distributor         Distributor?       @relation(fields: [distributorId], references: [id])
  purchaseOrder       PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  salesOrder          SalesOrder?        @relation(fields: [salesOrderId], references: [id])

  @@index([distributorId])
  @@index([purchaseOrderId])
  @@index([documentType])
}

