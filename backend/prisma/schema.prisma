generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  isAnalyzed     Boolean  @default(false)
  asins          ASIN[]
  privateLabels  PrivateLabel[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Manufacturer {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  isAnalyzed     Boolean  @default(false)
  asins          ASIN[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PrivateLabel {
  id               Int          @id @default(autoincrement())
  brandId          Int
  sellerId         String
  
  brand          Brand        @relation(fields: [brandId], references: [id])
  seller         Seller       @relation(fields: [sellerId], references: [id])

  @@unique([brandId, sellerId])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Seller {
  id             String           @id
  name           String
  privateLabels  PrivateLabel[]
  snapshots      SellerSnapshot[]
  asinSnapshots  AsinSnapshot[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model SellerSnapshot {
  id             Int      @id @default(autoincrement())
  sellerId       String
  name           String
  createdAt      DateTime @default(now())

  seller         Seller   @relation(fields: [sellerId], references: [id])
}

model Distributor {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  website   String?
  asins     ASIN[]   // implicit m-to-m
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ASIN {
  id             Int           @id @default(autoincrement())
  code           String        @unique
  brandId        Int?
  manufacturerId Int?
  
  brand          Brand?        @relation(fields: [brandId], references: [id])
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])
  distributors   Distributor[] // implicit m-to-m

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  snapshots      AsinSnapshot[]
}

model AsinSnapshot {
  id               Int      @id @default(autoincrement())
  asinId           Int
  buyBoxSeller     String?
  sellerId         String?
  sellerPercentage Int?
  createdAt        DateTime @default(now())

  asin             ASIN     @relation(fields: [asinId], references: [id])
  seller           Seller?  @relation(fields: [sellerId], references: [id])
}

view PrivateLabelView {
  id               Int      @unique
  brandId          Int
  sellerId         String
  brandName        String
  sellerName       String
  createdAt        DateTime
  updatedAt        DateTime
}
