generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

enum BrandStatus {
  UNPROCESSED
  NO_EU_DISTRIBUTOR
  CONTRACTED
}

/// Статусы жизненного цикла расчета комиссий FBA и габаритов товара
enum FeeCalculationStatus {
  KEEPA_REQUESTED    /// Запрошено в Keepa API (стоит в очереди или отправлен запрос)
  KEEPA_SUCCESS      /// Успешно получено из Keepa (есть комиссии и габариты)
  KEEPA_UNKNOWN      /// Keepa не имеет данных (габариты -1 или комиссии null на стороне Amazon)
  SUPPLIER_ENRICHING /// Пробуем обогатить из каталога/прайс-листа поставщика
  SUPPLIER_SUCCESS   /// Успешно обогащено из данных поставщика (рассчитан Size Tier и FBA fee)
  FAILED             /// Неуспешный (ни в Keepa, ни у поставщика нет данных)
}

model Brand {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  status        BrandStatus    @default(UNPROCESSED)
  notes         String?
  asins         ASIN[]
  privateLabels PrivateLabel[]
  keepaExports  KeepaExport[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Manufacturer {
  id         Int                 @id @default(autoincrement())
  name       String              @unique
  isAnalyzed Boolean             @default(false)
  asins      ASIN[]
  aliases    ManufacturerAlias[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model ManufacturerAlias {
  id             Int          @id @default(autoincrement())
  rawName        String       @unique
  manufacturerId Int
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([manufacturerId])
}

model PrivateLabel {
  id       Int     @id @default(autoincrement())
  brandId  Int
  sellerId String
  notes    String?

  brand     Brand    @relation(fields: [brandId], references: [id])
  seller    Seller   @relation(fields: [sellerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, sellerId])
}

model Seller {
  id             String           @id
  name           String
  privateLabels  PrivateLabel[]
  snapshots      SellerSnapshot[]
  productFinders ProductFinder[]
  keepaExports   KeepaExport[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model SellerSnapshot {
  id        Int      @id @default(autoincrement())
  sellerId  String
  name      String
  createdAt DateTime @default(now())

  seller Seller @relation(fields: [sellerId], references: [id])
}

enum DistributorStatus {
  NEW
  FORM_SUBMITTED
  EMAIL_SENT
  CALLED
  ACCOUNT_OPENED
  REJECTED
}

model Distributor {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  website         String?
  email           String?
  phone           String?
  domains         String[]          @default([]) /// Список почтовых доменов компании (например, ["alfadyser.es", "alfadyser.com"])
  status          DistributorStatus @default(NEW)
  rejectionReason String?
  notes           String?
  lastContactAt   DateTime?
  asins           ASIN[] // implicit m-to-m
  priceSnapshots  DistributorPriceSnapshot[]
  contacts        DistributorContact[] /// Список контактных лиц и менеджеров дистрибьютора
  emails          DistributorEmail[]   /// История переписки по электронной почте
  purchaseOrders  PurchaseOrder[]      /// Заказы на закупку и партии поставщика
  documents       OrderDocument[]      /// Прикрепленные документы и накладные
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

/// Контактное лицо дистрибьютора (менеджер, отдел продаж, бухгалтерия)
model DistributorContact {
  id            Int         @id @default(autoincrement())
  distributorId Int         /// Внешний ключ: связанный дистрибьютор
  name          String?     /// Имя контактного лица (например, "Guido")
  email         String      /// Электронная почта менеджера
  phone         String?     /// Телефон менеджера
  role          String?     /// Должность / отдел (например, "Comercial / Account Manager", "Atención al cliente")
  isPrimary     Boolean     @default(false) /// Основной ли это контакт для связи
  notes         String?     /// Дополнительные заметки по общению с контактом
  createdAt     DateTime    @default(now()) /// Дата создания записи
  updatedAt     DateTime    @updatedAt /// Дата последнего обновления

  distributor   Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@index([distributorId])
  @@index([email])
}

/// Сохраненное входящее или исходящее письмо из почтового ящика, связанное с дистрибьютором
model DistributorEmail {
  id             Int          @id @default(autoincrement())
  distributorId  Int?         /// Внешний ключ: дистрибьютор (может быть null, если письмо пока не сопоставлено)
  messageId      String       @unique /// Уникальный RFC 822 Message-ID письма для предотвращения дублирования
  uid            Int?         /// Уникальный номер письма в папке IMAP
  folder         String       @default("INBOX") /// Папка в почтовом ящике (INBOX, Sent и т.д.)
  fromEmail      String       /// Email адрес отправителя
  fromName       String?      /// Имя отправителя (например, "Guido - Alfa Dyser")
  toEmails       String[]     @default([]) /// Массив email адресов получателей
  ccEmails       String[]     @default([]) /// Массив адресов копии
  subject        String       /// Тема письма
  date           DateTime     /// Дата и время отправки письма
  bodyText       String?      /// Очищенный текстовый контент письма для поиска условий и ключевых слов
  bodyHtml       String?      /// Исходный HTML контент письма
  snippet        String?      /// Короткий текстовый фрагмент для быстрого предпросмотра
  hasAttachments Boolean      @default(false) /// Флаг наличия прикрепленных файлов
  attachments    Json?        /// Метаданные вложений (имя файла, размер, mime-тип, локальный путь к сохраненному файлу)
  isRead         Boolean      @default(false) /// Прочитано ли письмо
  createdAt      DateTime     @default(now()) /// Дата сохранения письма в базу данных
  updatedAt      DateTime     @updatedAt /// Дата последнего обновления

  distributor    Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)

  @@index([distributorId])
  @@index([fromEmail])
  @@index([date(sort: Desc)])
}


model ASIN {
  id             Int    @id @default(autoincrement())
  code           String @unique
  brandId        Int?
  manufacturerId Int?

  brand          Brand?        @relation(fields: [brandId], references: [id])
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])
  distributors   Distributor[] // implicit m-to-m
  priceSnapshots DistributorPriceSnapshot[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  feeStatus      FeeCalculationStatus? /// Статус расчета комиссий и габаритов FBA
  productFinders ProductFinder[]
  keepaExports   KeepaExport[]
  tags           Tag[]
  purchaseOrderItems PurchaseOrderItem[] /// Позиции в заказах закупки
  warehouseStocks    WarehouseStock[]    /// Остатки на складах
  stockMovements     StockMovement[]     /// Движения по складам
  salesOrderItems    SalesOrderItem[]    /// Продажи на маркетплейсах

  @@index([brandId, manufacturerId])
}

/// Снапшот закупочных цен из прайс-листов дистрибьюторов/поставщиков
model DistributorPriceSnapshot {
  id            Int         @id @default(autoincrement())
  distributorId Int         /// Внешний ключ: ID дистрибьютора
  asinId        Int?        /// Внешний ключ: сопоставленный ASIN в нашей базе данных
  ean           String?     /// Штрихкод EAN товара из прайс-листа (для автосопоставления)
  priceNetto    Float       /// Оптовая цена закупки без НДС (в евро)
  ecoTasa       Float?      /// Экологический сбор (эко-таса / RAEE) в евро за единицу товара
  costPrice     Float       /// Себестоимость с испанскими налогами ((priceNetto + COALESCE(ecoTasa, 0)) * 1.262: 21% IVA + 5.2% Recargo de Equivalencia)
  unitsPerBox   Int?        /// Количество штук в стандартной заводской упаковке / коробке (EMBALAJE у Cofan, UNI CAJA STD у Safta)
  minBoxOrder   Int?        /// Минимальный объем партии в штуках (unitsPerBox * minBoxEnvases для кратности коробок, либо прямое количество штук)
  createdAt     DateTime    @default(now()) /// Дата и время загрузки прайс-листа

  distributor   Distributor @relation(fields: [distributorId], references: [id])
  asin          ASIN?       @relation(fields: [asinId], references: [id])

  @@index([distributorId, asinId, createdAt(sort: Desc)])
  @@index([asinId])
  @@index([ean])
}

